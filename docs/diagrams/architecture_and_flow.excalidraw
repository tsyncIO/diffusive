      "version": 1,
      "versionNonce": 693219,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "def bootstrap_comfyui_runtime() -> None:\n    config = Configuration(cwd=comfyui_path, base_directory=comfyui_path, guess_settings=True)\n    setup_pre_torch(config)\n    folder_names = FolderNames(is_root=True)\n    init_default_paths(folder_names, config, replace_existing=True)\n    comfyui_execution_context.set(\n        replace(current_execution_context(), configuration=config, folder_names_and_paths=folder_names)\n    )\n    setup_post_torch(config)\n    # import_custom_nodes() & activate shim\n    prepare_vanilla_environment()\n    nodes_shim = sys.modules.get(\"nodes\")\n    nodes_shim.activate()",
      "originalText": "def bootstrap_comfyui_runtime() -> None:\n    config = Configuration(cwd=comfyui_path, base_directory=comfyui_path, guess_settings=True)\n    setup_pre_torch(config)\n    folder_names = FolderNames(is_root=True)\n    init_default_paths(folder_names, config, replace_existing=True)\n    comfyui_execution_context.set(\n        replace(current_execution_context(), configuration=config, folder_names_and_paths=folder_names)\n    )\n    setup_post_torch(config)\n    # import_custom_nodes() & activate shim\n    prepare_vanilla_environment()\n    nodes_shim = sys.modules.get(\"nodes\")\n    nodes_shim.activate()",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
